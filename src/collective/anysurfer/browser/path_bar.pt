<div class="plone-breadcrumb"
     id="portal-breadcrumbs"
     tal:define="
       breadcrumbs view/breadcrumbs;
     "
     i18n:domain="plone"
>
  <div class="container">
    <span class="hiddenStructure"
          id="breadcrumbs-you-are-here"
          i18n:translate="you_are_here"
    >You are here:</span>
    <ol aria-labelledby="breadcrumbs-you-are-here">
      <li id="breadcrumbs-home">
        <a tal:attributes="
             href view/navigation_root_url;
           "
           i18n:translate="tabs_home"
        >Home</a>
      </li>
      <li tal:repeat="crumb breadcrumbs"
          tal:attributes="
            id string:breadcrumbs-${repeat/crumb/number};
          "
      >
        <tal:item tal:define="
                    is_last repeat/crumb/end;
                    url crumb/absolute_url;
                    title crumb/Title;
                  ">
          <a href="#"
             tal:condition="python:not is_last"
             tal:content="title"
             tal:omit-tag="not: url"
             tal:attributes="
               href url;
             "
          >
                  crumb
          </a>
          <span id="breadcrumbs-current"
                tal:condition="is_last"
                tal:content="title"
          >crumb</span>
        </tal:item>
      </li>
    </ol>
  </div>
</div>
