<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        name="portal_controlpanel"
        purge="False"
        i18n:domain="collective.anysurfer"
>

  <configlet action_id="anysurfer"
             appId="collective.anysurfer"
             category="Products"
             condition_expr=""
             icon_expr="string:$portal_url/++resource++collective.anysurfer/anysurfer.png"
             title="Anysurfer"
             url_expr="string:${portal_url}/@@anysurfer-settings"
             visible="True"
             i18n:attributes="title"
  >
    <permission>collective.anysurfer: Manage control panel</permission>
  </configlet>

</object>
